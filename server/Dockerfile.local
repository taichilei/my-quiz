# 直接使用本地已经编译好的二进制进行打包
# 构建阶段已经在本地完成，不需要拉取 golang 镜像

# 运行阶段
FROM postgres:16-alpine

WORKDIR /app

# postgres:16-alpine 已经包含 ca-certificates，不需要额外安装

# 复制本地构建的二进制
COPY my-quiz-server .

# 暴露端口
EXPOSE 8080

# 环境变量
ENV PORT=8080
ENV POSTGRES_URI=postgres://postgres:postgres@postgres:5432/my-quiz?sslmode=disable

CMD ["./my-quiz-server"]
