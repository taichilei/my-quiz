# 本机开发模式环境变量模板
# 用法：cp server/.env.example server/.env
# server/.env 已被 .gitignore 排除，不会提交

# PostgreSQL（dev 模式连 docker 暴露的 5434）
POSTGRES_URI=postgres://postgres:postgres@localhost:5434/my-quiz?sslmode=disable

# Server
PORT=8080
JWT_SECRET=dev-only-secret-change-in-prod

# SMTP（dev 模式连本机 mailpit；UI 在 http://localhost:8025）
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=dev@my-quiz.local
SMTP_PASSWORD=dev
SMTP_FROM_NAME=MyQuiz Dev
